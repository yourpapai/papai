{
  "name": "papai",
  "version": "6.12.1",
  "private": true,
  "description": "papai — an intelligent Telegram bot for managing Kaneo tasks with LLM.",
  "license": "BUSL-1.1",
  "workspaces": [
    "review-loop"
  ],
  "type": "module",
  "module": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./plugin-types": "./src/providers/public-types.ts"
  },
  "scripts": {
    "benchmark:tool-surface": "bun scripts/tool-surface-benchmark.ts",
    "build:client": "bun scripts/build-client.ts",
    "storybook:prepare": "mkdir -p public && msw init public/ --no-save && cat client/shared/base.css client/shared/tokens.css > public/storybook-shared.css && cat client/shared/base.css client/shared/tokens.css client/settings/settings.css > public/storybook-settings.css && cat client/shared/base.css client/shared/tokens.css client/admin/admin.css > public/storybook-admin.css && cat client/shared/base.css client/shared/tokens.css client/debug/debug.css > public/storybook-debug.css && cat client/shared/base.css client/shared/tokens.css client/transcript/transcript.css > public/storybook-transcript.css",
    "storybook": "bun storybook:prepare && storybook dev -p 6006 --no-open",
    "build:storybook": "bun storybook:prepare && storybook build -o storybook-static",
    "shoot:gen": "crvy-strybk generate --config ./strybk.config.ts && bun run format >/dev/null && bun run license:headers >/dev/null",
    "shoot": "playwright test --update-snapshots",
    "visual:audit": "VISUAL_AUDIT=1 playwright test",
    "check:bundle-isolation": "bun build:client && bun run scripts/check-bundle-isolation.ts",
    "start": "bun build:client && bun run src/index.ts",
    "start:debug": "bun build:client && DEBUG_SERVER=true bun run src/index.ts",
    "review-loop:test": "bun run --filter review-loop test",
    "review-loop:typecheck": "bun run --filter review-loop typecheck",
    "review-loop:lint": "bun run --filter review-loop lint",
    "review-loop:format:check": "bun run --filter review-loop format:check",
    "review-loop:start": "bun run --filter review-loop start",
    "knip": "knip-bun --strict --no-gitignore",
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint --config .oxlintrc.json --ignore-path .oxlintignore .",
    "lint:fix": "oxlint --config .oxlintrc.json --fix --ignore-path .oxlintignore .",
    "format": "oxfmt --write . --ignore-path=.oxfmtignore",
    "format:check": "oxfmt --check . --ignore-path=.oxfmtignore",
    "security": "bun run scripts/run-semgrep.ts",
    "security:ci": "bun run scripts/run-semgrep.ts --ci",
    "test": "bun test --parallel",
    "test:serial": "bun test",
    "test:client": "bun --conditions=browser test --preload ./tests/client-setup.ts --path-ignore-patterns '' tests/client/",
    "test:watch": "bun test --watch",
    "test:coverage": "bun scripts/ensure-client-built.ts && bun test --coverage",
    "coverage:ratchet": "bun scripts/coverage/ratchet.ts",
    "coverage:ratchet:stories": "bun scripts/coverage/ratchet-stories.ts",
    "test:mutate": "bun scripts/mutation/all-files.ts",
    "test:mutate:changed": "bun scripts/mutation/changed-files.ts",
    "test:mutate:file": "bun scripts/mutation/paired-run.ts",
    "test:mutate:seed": "bun scripts/mutation/seed-from.ts",
    "test:mutate:changed-paired": "bun scripts/mutation/changed-files.ts",
    "test:e2e": "bun test --preload ./tests/e2e/bun-test-setup.ts --path-ignore-patterns '' tests/e2e/e2e.test.ts",
    "test:e2e:watch": "bun test --preload ./tests/e2e/bun-test-setup.ts --path-ignore-patterns '' tests/e2e/e2e.test.ts --watch",
    "test:smoke": "bun test ./tests/smoke/run-smoke.ts",
    "test:platform": "bun test ./tests/platform/run-platform.ts",
    "test:stories": "bun scripts/story/test-stories.ts",
    "test:stories:coverage": "bun scripts/story/test-stories.ts --coverage",
    "test:stories:contracts": "bun scripts/story/test-stories.ts --contracts",
    "test:stories:sandbox": "bun scripts/story/test-story-sandbox.ts",
    "test:stories:stress": "bun scripts/story/test-stories.ts --rerun-each 10 --randomize",
    "test:stories:manifest": "bun scripts/story/test-stories.ts --manifest-only",
    "test:stories:compat": "bun scripts/story/test-stories.ts --compat",
    "check": "./scripts/check.sh --staged",
    "check:full": "./scripts/check.sh",
    "check:verbose": "bun run --parallel lint typecheck format:check knip test duplicates review-loop:lint review-loop:typecheck review-loop:format:check review-loop:test",
    "fix": "bun run lint:fix && bun run format",
    "duplicates": "bun run scripts/detect-duplicates.ts",
    "prepare": "[ -d .git ] && cp scripts/pre-commit.sh .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit || true",
    "changelog:preview": "git-cliff --dry-run",
    "changelog:generate": "git-cliff -o CHANGELOG.md",
    "audit:behavior": "bun scripts/behavior-audit/index.ts",
    "audit:behavior:profile-clustering": "bun scripts/behavior-audit/profile-clustering.ts",
    "plan-adr-workflow": "bun scripts/plan-adr-workflow.ts",
    "codeindex:index": "bun run scripts/codeindex-cli.ts index",
    "codeindex:reindex": "bun run scripts/codeindex-cli.ts reindex",
    "codeindex:stats": "bun run scripts/codeindex-cli.ts stats",
    "license:headers": "bun scripts/add-license-headers.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.13",
    "@ai-sdk/provider": "^4.0.3",
    "@gramio/format": "^0.9.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@typescript/typescript6": "^6.0.2",
    "ai": "^7.0.32",
    "ai-tokenizer": "^1.0.6",
    "date-fns-tz": "^3.2.0",
    "defuddle": "^0.19.1",
    "discord.js": "^14.27.0",
    "drizzle-orm": "^0.45.2",
    "grammy": "^1.45.1",
    "ipaddr.js": "^2.4.0",
    "linkedom": "^0.18.13",
    "marked": "^18.0.7",
    "p-limit": "^7.3.1",
    "pino": "^10.3.1",
    "rrule-temporal": "^2.0.0",
    "svelte": "^5.56.7",
    "typescript": "^7.0.2",
    "unpdf": "^1.6.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@crvy/rprtr": "^0.2.4",
    "@crvy/strybk": "^0.0.5",
    "@gramio/types": "^10.2.0",
    "@grammyjs/types": "^4.0.0",
    "@happy-dom/global-registrator": "^20.11.0",
    "@hughescr/stryker-bun-runner": "^1.3.8",
    "@opencode-ai/plugin": "1.18.4",
    "@opencode-ai/sdk": "^1.18.4",
    "@playwright/test": "^1.61.1",
    "@storybook/addon-a11y": "^10.5.3",
    "@storybook/addon-svelte-csf": "^5.1.2",
    "@storybook/svelte-vite": "^10.5.3",
    "@stryker-mutator/core": "^9.6.0",
    "@sveltejs/vite-plugin-svelte": "^7",
    "@types/bun": "1.3.14",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "dependency-cruiser": "^18.1.0",
    "drizzle-kit": "^0.31.10",
    "happy-dom": "^20.11.0",
    "jscpd": "^5.0.12",
    "knip": "^6.27.0",
    "msw": "^2.15.0",
    "msw-storybook-addon": "^2.0.7",
    "oxfmt": "^0.59.0",
    "oxlint": "1.74.0",
    "oxlint-tsgolint": "^0.22.1",
    "storybook": "^10.5.3",
    "vite": "^8.1.5"
  },
  "overrides": {
    "typescript": "$@typescript/typescript6"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
