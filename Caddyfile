{$KANEO_CLIENT_URL} {
	# Bot-internal member provisioning signs up through the task instance's
	# internalUrl (bot → kaneo:5173), never this public edge. Do not open this
	# rule to make member provisioning work — configure internalUrl instead.
	handle /api/auth/sign-up/* {
		respond 403
	}
	handle /api/auth/sign-in/social {
		respond 403
	}
	handle /api/auth/anonymous {
		respond 403
	}
	handle /api/auth/callback/* {
		respond 403
	}
	reverse_proxy kaneo:5173
}
