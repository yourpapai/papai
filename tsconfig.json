{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "types": ["bun"],
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noPropertyAccessFromIndexSignature": true,

    // Path alias for the stable plugin-types surface
    "paths": {
      "papai/plugin-types": ["./src/providers/public-types.ts"]
    }
  },
  // `reports/` is the gitignored evidence tree: generated check artifacts and the
  // test-audit benchmark's .bench.ts arms (which intentionally carry an unused
  // import so a pairing's arms stay import-identical). Not source; never typechecked.
  "exclude": [".pi", ".opencode", "docs/superpowers/extensions", "public", "reports", "storybook-static"]
}
