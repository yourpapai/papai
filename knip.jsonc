{
  "$schema": "./node_modules/knip/schema.json",

  // The review-loop workspace is a standalone developer tool with its own
  // check suite (review-loop:lint/typecheck/format:check/test) run separately
  // in check:full. knip-bun cannot resolve its .js-extension imports, so
  // exclude it from analysis here.
  "ignoreWorkspaces": ["review-loop"],

  // Entry points not auto-detected from package.json scripts
  "entry": [
    "client/admin/index.ts!",
    "client/debug/index.ts!",
    "client/settings/index.ts!",
    "client/transcript/index.ts!",
    "scripts/behavior-audit/index.ts!",
    "scripts/behavior-audit/profile-clustering.ts!",
    "scripts/behavior-audit/tune-embedding.ts!",
    "scripts/behavior-audit/reset.ts!",
    "scripts/behavior-audit/migrate-trust.ts!",
    "playwright.config.ts!",
    "strybk.config.ts!",
    // First-party plugin entry points are loaded dynamically by the plugin loader,
    // so they have no static importer; declare them as entries.
    "plugins/*/index.ts!",
  ],

  // All source files (production only). plugins/** is included so knip tracks
  // plugin->src usage (e.g. clearCachedTools, consumed only by a provider plugin).
  "project": ["src/**/*.ts!", "client/**/*.ts!", "scripts/behavior-audit/**/*.ts!", "plugins/**/*.ts!"],

  // All issue types treated as hard errors
  "rules": {
    "files": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "optionalPeerDependencies": "error",
    "unlisted": "error",
    "binaries": "error",
    "unresolved": "error",
    "exports": "error",
    "types": "error",
    "nsExports": "error",
    "nsTypes": "error",
    "duplicates": "error",
    "enumMembers": "error",
    "catalog": "error",
  },

  // Ignore Stryker plugin (loaded at runtime, not imported).
  // svelte is imported by client entry points but knip can't follow .svelte component imports.
  // msw is the dev-only mock layer dependency consumed exclusively by the
  // Storybook story harness under client/stories/** (ignored below); it never
  // ships in a production bundle.
  // @crvy/strybk is imported by strybk.config.ts but knip-bun cannot resolve the
  // package even though it is listed in devDependencies (runtime CLI config consumer).
  "ignoreDependencies": ["@stryker-mutator/typescript-checker", "svelte", "msw", "@crvy/strybk"],

  "ignoreIssues": {
    // defaultBroadcastDepsForTest is a test-only seam.
    "src/announcements/broadcast.ts": ["exports"],
    // applyVisibility is unused; turn-assembly re-exports are consumed only by .svelte files.
    "src/debug/state-collector.ts": ["exports"],
    // resetTurnBuffers is a test-only seam.
    "src/debug/turn-assembly.ts": ["exports"],
    // subscribeCountForTest is a test-only seam.
    "src/debug/event-bus.ts": ["exports"],
    // setPluginConfig is a test-only seam.
    "src/config.ts": ["exports"],
    // resetPluginRegistryForTesting is a test-only seam.
    "src/plugins/registry.ts": ["exports"],
    // resetContributionCollisionStateForTesting is a test-only seam.
    "src/plugins/contributions.ts": ["exports"],
    // getTaskProviderProvision is a forward-compat export wired in a downstream
    // task of the plugins deployment safety plan (mirrors getTaskProviderConfigValidator).
    "src/providers/registry.ts": ["exports"],
    // systemConfigCacheForTesting is a test-only seam.
    "src/system-config.ts": ["exports"],
    // resetNotifyTokenCacheForTesting is a test-only seam.
    "src/notify-token.ts": ["exports"],
    // resetStatsSaltCacheForTesting is a test-only seam.
    "src/stats/hashing.ts": ["exports"],
    // clearStatsCacheForTesting is a test-only seam.
    "src/stats/index.ts": ["exports"],
    // resetUsageRecorderForTesting is a test-only seam.
    "src/usage/index.ts": ["exports"],
    // resetPermissionPromptForTesting is a test-only seam.
    "src/chat/permission-prompt.ts": ["exports"],
    // setResultStoreClockForTesting and clearResultStoreForTesting are test-only seams.
    "src/tools/compaction/result-store.ts": ["exports"],
    // clearModelBuilderCacheForTesting is a test-only seam.
    "src/llm-model-builder.ts": ["exports"],
    // clearGroupAdminLiveCache is a test-only seam.
    "src/chat/group-admin-live.ts": ["exports"],
    // clearBriefEmbeddingCachesForTesting is a test-only seam.
    "src/tools/disclosure/embedding-tool-retriever.ts": ["exports"],
    // Mattermost action context signing is created ahead of the action adapter integration.
    "src/chat/mattermost/action-signing.ts": ["files"],
    // Mattermost action callback route entry points are created ahead of the web server route wiring.
    "src/chat/mattermost/action-callbacks.ts": ["exports"],
    // BYOK store is created ahead of settings route integration in the BYOK LLM credentials plan.
    "src/byok-llm/store.ts": ["files", "exports"],
    "src/byok-llm/types.ts": ["files", "types"],
    // mcp-gitlab tool input schemas are created ahead of tool registration wiring in a later task.
    "plugins/mcp-gitlab/input-schema.ts": ["files"],
    // mcp-gitlab response shaping/query helpers are created ahead of client wiring in a later task.
    "plugins/mcp-gitlab/format.ts": ["files"],
    // mcp-gitlab GitLab REST client is created ahead of tool registration wiring in a later task.
    "plugins/mcp-gitlab/client.ts": ["files"],
    // isBlockedResult is a test-only seam.
    "src/mcp-server/redaction.ts": ["exports"],
    // partitionToolNames is a test-only seam.
    "src/tools/tool-preferences.ts": ["exports"],
    // deleteAdminsByPlatformInstance, listAdminsForPlatform are test-only seams.
    "src/instances/admin-store.ts": ["exports"],
    // deleteContextsByTaskInstance, deleteContextsByPlatformInstance are test-only seams.
    "src/instances/context-store.ts": ["exports"],
    // knip --strict cannot trace test-to-test cross-references.
    "tests/scripts/behavior-audit-integration.helpers.ts": ["exports"],
    "tests/scripts/behavior-audit-integration.runtime-helpers.ts": ["exports"],
    "tests/scripts/behavior-audit-integration.support.ts": ["exports", "types"],
    "tests/scripts/behavior-audit/test-fixtures.ts": ["exports"],
    // setStoreDb is a test-only seam.
    "src/dashboard-auth/store.ts": ["exports"],
    // routeRequestForTest is a test-only seam.
    "src/debug/server.ts": ["exports"],
    // The client uses Svelte components that knip can't parse, so most of these
    // exports look orphaned even though .svelte files consume them.
    "client/admin/auth.ts": ["exports"],
    "client/debug/auth.ts": ["exports"],
    "client/debug/handlers.ts": ["exports"],
    "client/debug/log-bootstrap.ts": ["exports"],
    // pinOperatorFirst is consumed only by SessionsList.svelte, which knip can't parse.
    "client/debug/session-order.ts": ["exports"],
    "client/debug/sse.ts": ["exports"],
    // filterFromParams/filterToQuery/emptyFilter are consumed only by DebugApp.svelte, which knip can't parse.
    "client/debug/log-filter-url.ts": ["exports"],
    // SessionDetail is a type used in tests and by .svelte components knip cannot parse.
    "client/debug/types.ts": ["files", "types"],
    "client/admin/admin.svelte.ts": ["exports", "types"],
    // Transcript viewer: only consumed by .svelte components knip can't parse.
    "client/transcript/transcript.svelte.ts": ["files", "exports", "types"],
    "client/admin/global-stats.svelte.ts": ["types"],
    "client/admin/fetcher-schemas.ts": ["files", "exports"],
    "client/admin/fetchers.ts": ["files", "exports", "types"],
    "client/admin/plugin-config-fetcher-schemas.ts": ["files", "exports"],
    "client/admin/plugin-config-fetchers.ts": ["files", "exports"],
    "client/admin/instance-fetchers.ts": ["exports"],
    "client/admin/index.ts": ["files", "exports"],
    "client/admin/scrollspy.ts": ["exports"],
    // Settings client: .svelte components consume these, but knip can't follow .svelte imports.
    "client/settings/fetcher-schemas.ts": ["types"],
    "client/settings/fetcher-schemas-admin.ts": ["types"],
    "client/settings/fetcher-schemas-tools.ts": ["types"],
    "client/settings/fetcher-schemas-mcp-catalog.ts": ["types"],
    "client/settings/fetcher-schemas-mcp-plugin-servers.ts": ["types"],
    "client/settings/fetchers.ts": ["exports"],
    "client/settings/coding-credentials-fetchers.ts": ["exports"],
    "client/settings/admin-fetchers.ts": ["exports"],
    "client/settings/release-fetchers.ts": ["exports"],
    "client/settings/repos-fetchers.ts": ["exports"],
    "client/settings/fetcher-schemas-repos.ts": ["types"],
    "client/settings/scrollspy.ts": ["exports"],
    "client/settings/session.svelte.ts": ["exports"],
    "client/settings/lib/mask-secret.ts": ["exports"],
    "client/settings/lib/truncate-middle.ts": ["exports"],
    // group-tools is consumed only by ToolsSection.svelte, which knip can't parse.
    // Permanent, not temporary.
    "client/settings/lib/group-tools.ts": ["files", "exports"],
    // validate-mcp-endpoint is consumed only by McpSection.svelte, which knip can't parse.
    "client/settings/lib/validate-mcp-endpoint.ts": ["files", "exports"],
    // describeMcpPosture is consumed only by AdminMcpCatalogEntryRow.svelte, which knip can't parse.
    "client/settings/sections/admin/mcp-posture.ts": ["exports"],
    // consumed only by the transcript viewer state/.svelte which knip can't parse.
    "client/transcript/fetcher-schemas.ts": ["files", "exports", "types"],
    "client/transcript/stitch.ts": ["files", "exports"],
    "client/transcript/fetchers.ts": ["files", "exports"],
    "client/transcript/sse.ts": ["files", "exports", "types"],
    "client/shared/fetcher-helpers.ts": ["exports"],
    "client/shared/helpers.ts": ["exports"],
    // formatFetchError is consumed only by GroupProviderSection.svelte, which knip can't parse.
    "client/shared/format-error.ts": ["exports"],
    "client/shared/api-types.ts": ["types"],
    "client/shared/ui/status-tone.ts": ["files", "exports"],
    // setFieldLabelId/getFieldLabelId are consumed only by Field/Input/Select .svelte, which knip can't parse.
    "client/shared/ui/field-context.ts": ["exports"],
    // Plugin entry-point default exports are imported dynamically by the plugin
    // loader (by path), so knip sees no static importer. Each new plugin adds a line.
    "plugins/acp/index.ts": ["exports"],
    "plugins/audio-transcribe/index.ts": ["exports"],
    "plugins/synthetic-web-search/index.ts": ["exports"],
    "plugins/task-provider-kaneo/index.ts": ["exports"],
    "plugins/task-provider-youtrack/index.ts": ["exports"],
    "plugins/nerv/index.ts": ["exports"],
    "plugins/mcp-sentry/index.ts": ["exports"],
    "plugins/mcp-confluence/index.ts": ["exports"],
    "plugins/mcp-figma/index.ts": ["exports"],
    "plugins/mcp-teamcity/index.ts": ["exports"],
    "plugins/mcp-rag/index.ts": ["exports"],
    "plugins/mcp-mattermost/index.ts": ["exports"],
    "plugins/mcp-gitlab/index.ts": ["exports"],
    // validateConfig is resolved dynamically by the loader from the manifest's
    // `providerConfigValidator` named export (re-exported through index.ts), so knip
    // sees no static consumer of the implementation.
    "plugins/task-provider-kaneo/validate-config.ts": ["exports"],
    "plugins/task-provider-youtrack/validate-config.ts": ["exports"],
    // Strict discovery migration moved these plugin runtime consumers behind
    // import.meta.require()-based plugin-local bridges, which Knip cannot trace.
    "plugins/task-provider-kaneo/auto-provision.ts": ["files"],
    "plugins/task-provider-kaneo/provision.ts": ["files", "exports"],
    "plugins/task-provider-kaneo/provision-messages.ts": ["files", "exports"],
    "plugins/task-provider-kaneo/client.ts": ["exports"],
    "plugins/task-provider-kaneo/provider.ts": ["exports"],
    "plugins/task-provider-youtrack/provider.ts": ["exports"],
    // audio-transcribe moved its zod-using implementation behind an
    // import.meta.require('./runtime.js') bridge (mirrors task-provider-kaneo) to keep
    // the discovery scanner's static entry graph free of bare-module imports. Knip
    // cannot trace the dynamic require, so the runtime module and the transcription
    // helper it statically imports appear unimported.
    "plugins/audio-transcribe/runtime.ts": ["files", "exports"],
    "plugins/audio-transcribe/transcription.ts": ["files"],
    "src/cache.ts": ["exports"],
    "src/types/config.ts": ["exports"],
    // strybk.config.ts default export is consumed by the crvy-strybk CLI at
    // runtime via --config; no static importer exists.
    "strybk.config.ts": ["exports"],
  },

  // Report unused exports even in entry files
  "includeEntryExports": true,

  // Config hints become hard errors
  "treatConfigHintsAsErrors": true,
  "ignoreExportsUsedInFile": true,

  // Ignore migration files and generated/runtime-only code that knip should not analyze as files.
  // client/stories/** is the dev-only Storybook mock + story harness: it is reachable only through
  // Storybook's dev entries and .svelte stories (which knip cannot parse), and is excluded from
  // production bundles by design, so production-mode analysis correctly cannot trace it.
  "ignore": ["src/db/migrations/**", "client/stories/**", "tests/visual/**"],
}
