{
  "$schema": "./node_modules/knip/schema.json",

  // Entry points not auto-detected from package.json scripts
  "entry": [
    "client/admin/index.ts!",
    "client/debug/index.ts!",
    "tests/review-loop/**/*.test.ts!",
    "scripts/behavior-audit/index.ts!",
    "scripts/behavior-audit/profile-clustering.ts!",
    "scripts/behavior-audit/tune-embedding.ts!",
    "scripts/behavior-audit/reset.ts!",
    "scripts/behavior-audit/migrate-trust.ts!",
    // First-party plugin entry points are loaded dynamically by the plugin loader,
    // so they have no static importer; declare them as entries.
    "plugins/*/index.ts!",
  ],

  // All source files (production only). plugins/** is included so knip tracks
  // plugin->src usage (e.g. clearCachedTools, consumed only by a provider plugin).
  "project": [
    "src/**/*.ts!",
    "client/**/*.ts!",
    "review-loop/src/**/*.ts!",
    "scripts/behavior-audit/**/*.ts!",
    "plugins/**/*.ts!",
  ],

  // All issue types treated as hard errors
  "rules": {
    "files": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "optionalPeerDependencies": "error",
    "unlisted": "error",
    "binaries": "error",
    "unresolved": "error",
    "exports": "error",
    "types": "error",
    "nsExports": "error",
    "nsTypes": "error",
    "duplicates": "error",
    "enumMembers": "error",
    "catalog": "error",
  },

  // Ignore Stryker plugin (loaded at runtime, not imported).
  // svelte is imported by client entry points but knip can't follow .svelte component imports.
  // msw is the dev-only mock layer dependency consumed exclusively by the
  // Storybook story harness under client/stories/** (ignored below); it never
  // ships in a production bundle.
  "ignoreDependencies": ["@stryker-mutator/typescript-checker", "svelte", "msw"],

  "ignoreIssues": {
    // applyVisibility is unused; turn-assembly re-exports are consumed only by .svelte files.
    "src/debug/state-collector.ts": ["exports"],
    // resetTurnBuffers is a test-only seam.
    "src/debug/turn-assembly.ts": ["exports"],
    // setPluginConfig is a test-only seam.
    "src/config.ts": ["exports"],
    // resetPluginRegistryForTesting is a test-only seam.
    "src/plugins/registry.ts": ["exports"],
    // systemConfigCacheForTesting is a test-only seam.
    "src/system-config.ts": ["exports"],
    // resetStatsSaltCacheForTesting is a test-only seam.
    "src/stats/hashing.ts": ["exports"],
    // clearStatsCacheForTesting is a test-only seam.
    "src/stats/index.ts": ["exports"],
    // resetUsageRecorderForTesting is a test-only seam.
    "src/usage/index.ts": ["exports"],
    // deleteAdminsByPlatformInstance, listAdminsForPlatform are test-only seams.
    "src/instances/admin-store.ts": ["exports"],
    // deleteContextsByTaskInstance, deleteContextsByPlatformInstance are test-only seams.
    "src/instances/context-store.ts": ["exports"],
    // knip --strict cannot trace test-to-test cross-references.
    "tests/scripts/behavior-audit-integration.helpers.ts": ["exports"],
    "tests/scripts/behavior-audit-integration.runtime-helpers.ts": ["exports"],
    "tests/scripts/behavior-audit-integration.support.ts": ["exports", "types"],
    "tests/scripts/behavior-audit/test-fixtures.ts": ["exports"],
    // setStoreDb is a test-only seam.
    "src/dashboard-auth/store.ts": ["exports"],
    // routeRequestForTest is a test-only seam.
    "src/debug/server.ts": ["exports"],
    // The client uses Svelte components that knip can't parse, so most of these
    // exports look orphaned even though .svelte files consume them.
    "client/admin/auth.ts": ["exports"],
    "client/debug/auth.ts": ["exports"],
    "client/debug/handlers.ts": ["exports"],
    "client/debug/log-bootstrap.ts": ["exports"],
    "client/debug/log-filter.ts": ["exports"],
    "client/debug/sse.ts": ["exports"],
    "client/debug/types.ts": ["types"],
    "client/admin/admin.svelte.ts": ["exports", "types"],
    "client/admin/global-stats.svelte.ts": ["types"],
    "client/admin/fetcher-schemas.ts": ["files", "exports"],
    "client/admin/fetchers.ts": ["files", "exports", "types"],
    "client/admin/plugin-config-fetcher-schemas.ts": ["files", "exports"],
    "client/admin/plugin-config-fetchers.ts": ["files", "exports"],
    "client/admin/instance-fetchers.ts": ["exports"],
    "client/admin/index.ts": ["files", "exports"],
    "client/admin/scrollspy.ts": ["exports"],
    "client/shared/fetcher-helpers.ts": ["exports"],
    "client/shared/helpers.ts": ["exports"],
    "client/shared/api-types.ts": ["types"],
    // Plugin entry-point default exports are imported dynamically by the plugin
    // loader (by path), so knip sees no static importer. Each new plugin adds a line.
    "plugins/synthetic-web-search/index.ts": ["exports"],
    "plugins/task-provider-kaneo/index.ts": ["exports"],
  },

  // Report unused exports even in entry files
  "includeEntryExports": true,

  // Config hints become hard errors
  "treatConfigHintsAsErrors": true,
  "ignoreExportsUsedInFile": true,

  // Ignore migration files and generated/runtime-only code that knip should not analyze as files.
  // client/stories/** is the dev-only Storybook mock + story harness: it is reachable only through
  // Storybook's dev entries and .svelte stories (which knip cannot parse), and is excluded from
  // production bundles by design, so production-mode analysis correctly cannot trace it.
  "ignore": ["src/db/migrations/**", "client/stories/**"],
}
