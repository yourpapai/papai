# First-run chat provider bootstrap: telegram, mattermost, or discord.
# Used only when platform_instances is empty; after bootstrap, manage instances
# from /admin#instances.
CHAT_PROVIDER=telegram

# NOTE: Task providers are no longer env-bootstrapped. There is no TASK_PROVIDER
# variable. After the bot starts, create the task instance via /admin#instances
# and approve the matching task-provider plugin (task-provider-kaneo or
# task-provider-youtrack) in the settings web UI admin area.

# Admin user ID (platform-specific: numeric for Telegram, string for Mattermost/Discord)
# This user is required at startup and is auto-authorized during first-run bootstrap.
ADMIN_USER_ID=123456789

# Production key for encrypting platform_instances.config and task_instances.config.
# Must be 32 bytes as 64 hex chars. If unset, papai derives a host-local fallback
# and logs a warning; set this explicitly before production use.
# INSTANCE_CONFIG_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Required for the settings web UI: external base URL used to build single-use
# /config links and to scope the Secure settings session cookie. Without it,
# /config replies asking the admin to configure this variable — there is no
# in-chat configuration fallback.
# SETTINGS_PUBLIC_BASE_URL=https://bot.example.com

# --- Telegram-specific (required when CHAT_PROVIDER=telegram) ---
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# --- Mattermost-specific (required when CHAT_PROVIDER=mattermost) ---
# MATTERMOST_URL=https://mm.example.com
# MATTERMOST_BOT_TOKEN=your_mattermost_bot_token_here

# --- Central LLM credentials (admin-owned, seeded into system_config on first start) ---
# Required. After the first start that finds the corresponding system_config row
# missing, these env vars are persisted into SQLite. Rotate later either by
# editing the env and restarting, or via /admin#system (no restart needed).
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
MAIN_MODEL=gpt-4o-mini
# Optional helper model used for cheaper operations. Callsites fall back to
# MAIN_MODEL when unset.
# SMALL_MODEL=gpt-4o-mini
# Optional embedding model used for semantic memo search. When unset, memo
# search degrades to keyword-only.
# EMBEDDING_MODEL=text-embedding-3-small

# Optional: Log level (debug, info, warn, error). Defaults to info.
LOG_LEVEL=info

# --- Task provider specific settings ---

# Kaneo:
# Public URL of the Kaneo instance. Bootstrap-only: read solely by legacy-repair
# when it creates the default Kaneo task instance on first start (the settings-UI
# provisioning route sources this from the bound task instance's own config
# instead). Also used by Caddy for TLS. The API is served under
# <KANEO_CLIENT_URL>/api — no separate API domain needed.
KANEO_CLIENT_URL=https://kaneo.example.com

# Internal URL used by the bot to call the Kaneo API directly (bypasses Caddy/TLS).
# Defaults to KANEO_CLIENT_URL when unset.
# KANEO_INTERNAL_URL=http://kaneo-api:1337

# YouTrack:
# The YouTrack instance URL is no longer an env var. It is a task-instance config
# field — set it when creating the task instance via /admin#instances.

# --- Kaneo self-host (docker compose) ---

# Required: PostgreSQL password for Kaneo database
KANEO_POSTGRES_PASSWORD=changeme

# Required: Secret for signing JWT tokens (32+ characters)
KANEO_AUTH_SECRET=change-me-to-a-random-string-at-least-32-chars

# Disable public sign-up on the Kaneo instance (default: true).
# Set to false temporarily when provisioning new accounts, then back to true.
KANEO_DISABLE_REGISTRATION=true

# Open DM access is no longer an env flag. A bot admin enables it per platform
# instance in the settings UI (admin "Users" section); when on, any user who DMs
# the bot is auto-added (added_by = 'open-access') and granted normal DM access,
# and admins can block individuals. Replaces the removed DEMO_MODE env var.

# Optional: PostgreSQL database name and user (defaults: kaneo)
# KANEO_POSTGRES_DB=kaneo
# KANEO_POSTGRES_USER=kaneo

# Per-user provider credentials and preferences (provider credential, workspace,
# timezone) are configured in the settings web UI:
#   - DM /config to receive a single-use link to the settings web UI
#     (requires SETTINGS_PUBLIC_BASE_URL above)
# Values are persisted in papai.db (SQLite).
# LLM credentials are NOT part of this flow — they live in the admin-owned
# system_config table, seeded from LLM_API_KEY / LLM_BASE_URL / MAIN_MODEL /
# SMALL_MODEL / EMBEDDING_MODEL above.

# --- Optional debug/admin server ---
# When DEBUG_SERVER=true the bot serves /debug and /admin. /dashboard redirects
# to /debug. Admin sections include /admin#system, /admin#billing,
# /admin#stats, and /admin#instances. DEBUG_TOKEN gates write routes and all
# routes when configured; POST /admin/llm returns 401 when DEBUG_TOKEN is unset.
# DEBUG_SERVER=true
# DEBUG_HOSTNAME=127.0.0.1
# DEBUG_PORT=9100
# DEBUG_TOKEN=change-me-to-a-random-token

# --- File Attachments (S3-compatible object storage) ---
# Required when you want the bot to receive and attach files.
# Works with AWS S3, Cloudflare R2, MinIO, Backblaze B2, etc.
# S3_BUCKET=your-bucket-name
# S3_ACCESS_KEY_ID=your-access-key
# S3_SECRET_ACCESS_KEY=your-secret-key
#
# Required for non-AWS providers (R2, MinIO, B2):
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
#
# Optional:
# S3_REGION=us-east-1
# S3_PREFIX=papai/prod          # Optional key prefix inside the bucket
# S3_FORCE_PATH_STYLE=true      # Set to 'true' for MinIO

# --- Discord-specific (required when CHAT_PROVIDER=discord) ---
# Bot Token from https://discord.com/developers/applications → your app → Bot → Reset Token.
# The bot must have the MESSAGE CONTENT INTENT enabled in the Developer Portal → Bot page.
# DISCORD_BOT_TOKEN=
