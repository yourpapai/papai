{
  "repoRoot": ".",
  "workDir": ".review-loop",
  "maxRounds": 10,
  "maxNoProgressRounds": 2,
  "agentTimeoutMs": 600000,
  "buildTimeoutMs": 600000,
  "poolSize": 3,
  "checkCommand": "bun check:full",
  "reviewer": {
    "model": "ollama-cloud/kimi-k2.6:cloud",
    "extraArgs": [],
    "timeoutMs": 1800000
  },
  "fixer": {
    "model": "opencode/claude-sonnet-4-6",
    "extraArgs": []
  },
  "matcher": {
    "model": "ollama-cloud/kimi-k2.6:cloud",
    "extraArgs": []
  },
  "inspector": {
    "model": "ollama-cloud/kimi-k2.6:cloud",
    "extraArgs": []
  }
}
