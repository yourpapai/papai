{
  "repoRoot": ".",
  "workDir": ".review-loop",
  "maxRounds": 10,
  "maxNoProgressRounds": 2,
  "agentTimeoutMs": 600000,
  "buildTimeoutMs": 600000,
  "runTimeoutMs": 0,
  "poolSize": 3,
  "checkCommand": "bun check:full",
  "commitAuthor": { "name": "review-loop[bot]", "email": "review-loop@users.noreply.github.com" },
  "reviewer": {
    "model": "ollama-cloud/kimi-k2.6:cloud",
    "extraArgs": [],
    "timeoutMs": 1800000
  },
  "fixer": {
    "model": "opencode/claude-sonnet-4-6",
    "extraArgs": [],
    "timeoutMs": 1800000
  },
  "matcher": {
    "model": "ollama-cloud/kimi-k2.6:cloud",
    "extraArgs": []
  },
  "inspector": {
    "model": "ollama-cloud/kimi-k2.6:cloud",
    "extraArgs": [],
    "timeoutMs": 1800000
  },
  "pricing": {
    "anthropic/claude-sonnet-*": { "input": 3, "output": 15, "cacheRead": 0.3, "cacheWrite": 3.75 },
    "anthropic/claude-opus-*": { "input": 15, "output": 75 }
  }
}
